generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Student {
  id         Int     @id @default(autoincrement())
  rollNo     Int     @unique
  name       String
  topic      String  @default("")
  review     String  @default("")
  disabled   Boolean @default(false)
  presented  Boolean @default(false)
}