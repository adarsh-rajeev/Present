generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Teacher {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Student {
  id       Int                  @id @default(autoincrement())
  rollNo   Int                  @unique
  name     String
  excluded Boolean              @default(false)
  currentTopic String?

  records  PresentationRecord[]
}

model PresentationSession {
  id            Int                  @id @default(autoincrement())
  sessionNumber Int                  @unique
  startedAt     DateTime             @default(now())
  endedAt       DateTime?
  records       PresentationRecord[]
}

model PresentationRecord {
  id                  Int                 @id @default(autoincrement())
  sessionId           Int
  studentId           Int
  presentationOrder   Int
  topic               String?
  overallRating       Int?
  communicationRating Int?
  confidenceRating    Int?
  contentRating       Int?
  remarks             String?
  presentedAt         DateTime            @default(now())
  status              PresentationStatus
  session             PresentationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

enum PresentationStatus {
  EXCELLENT
  GOOD
  AVERAGE
  NEEDS_IMPROVEMENT
}
